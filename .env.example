ZEROG_NETWORK=testnet

# Optional backend signer for server-side relays or broker-based compute
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# 0G Chain
ZEROG_RPC_URL=https://evmrpc-testnet.0g.ai
ZEROG_CHAIN_ID=16602
PRIVATE_AGENT_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_PRIVATE_AGENT_REGISTRY

# 0G Storage
ZEROG_STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# 0G Compute
# Broker mode: optional if you want server-side broker access
ZEROG_COMPUTE_PROVIDER=
ZEROG_COMPUTE_FALLBACK_PROVIDERS=0xf07240Efa67755B5311bc75784a061eDB47165Dd,0x3feE5a4dd5FDb8a32dDA97Bed899830605dBD9D3,0x6D233D2610c32f630ED53E8a7Cbf759568041f8f
# Direct API mode: optional alternative to broker mode
ZEROG_COMPUTE_API_KEY=
ZEROG_COMPUTE_API_BASE=
ZEROG_COMPUTE_MODEL=
# Keep true when using broker mode and TEE verification.
# `executionMode: "auto"` only prefers direct API when model is set and this flag is false.
ZEROG_COMPUTE_REQUIRE_TEE=true

# API
HOST=127.0.0.1
PORT=4000
